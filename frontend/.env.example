PORT=3001

# API Configuration
NEXT_PUBLIC_BASE_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL_FOR_CLIENT=https://example.com

# Authentication & Defaults
NEXT_PUBLIC_DEFAULT_USER_PASSWORD=123456

# Image Configuration
# Comma-separated list of allowed domains for Next.js Image component
NEXT_PUBLIC_ALLOWED_IMAGE_DOMAINS=api.example.com,example.com